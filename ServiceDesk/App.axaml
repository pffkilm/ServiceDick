<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ServiceDesk.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ServiceDesk/Resources/AppResources.axaml"/>
                <ResourceInclude Source="avares://ServiceDesk/Styles/StatusBadge.axaml"/> 
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://ServiceDesk/Styles/AppStyles.axaml"/>
    </Application.Styles>

    
</Application>