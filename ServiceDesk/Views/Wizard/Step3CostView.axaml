<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ServiceDesk.Views.Wizard.Step3CostView">
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Стоимость и срок" Classes="h1"/>

        <TextBlock Text="Стоимость (₽):"/>
        <TextBox Text="{Binding Cost}" Watermark="5000"/>

        <TextBlock Text="Срок (дней):"/>
        <TextBox Text="{Binding Days}" Watermark="3"/>

      
    </StackPanel>
</UserControl>