<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ServiceDesk.Views.RequestCard"
             x:Name="Root">
    <Border Classes="card"
            Background="{StaticResource PrimaryBrush}"
            Margin="5" Width="300">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding #Root.RequestNumber, StringFormat='Заявка {0}'}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="{Binding #Root.ClientName, StringFormat='Клиент: {0}'}"
                       Foreground="White"/>
            <TextBlock Text="{Binding #Root.Status, StringFormat='Статус: {0}'}"
                       Foreground="#FFD54F"/>
            <ProgressBar Value="{Binding #Root.Progress}"
                         Width="260" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>