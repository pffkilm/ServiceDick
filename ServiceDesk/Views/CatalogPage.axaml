<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ServiceDesk.Views.CatalogPage"
             Header="Каталог услуг">
    <Grid RowDefinitions="Auto,*" Margin="20">
        <TextBlock Grid.Row="0"
                   Text="Услуги сервисного центра"
                   Classes="h1"
                   Margin="0,0,0,15"/>
        <ListBox Grid.Row="1">
            <ListBoxItem>Диагностика — 500 ₽</ListBoxItem>
            <ListBoxItem>Замена экрана — 3000 ₽</ListBoxItem>
            <ListBoxItem>Чистка от пыли — 1000 ₽</ListBoxItem>
            <ListBoxItem>Замена аккумулятора — 2000 ₽</ListBoxItem>
            <ListBoxItem>Переустановка ОС — 1500 ₽</ListBoxItem>
        </ListBox>
    </Grid>
</ContentPage>